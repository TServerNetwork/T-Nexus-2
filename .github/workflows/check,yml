name: Check

on:
  pull_request:
    branches:
      - master

permissions:
  contents: read

jobs:
  check:
    name: Compile and test
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7
      
      - name: Set up Java
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "25"
      
      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v6
      
      - name: Build
        run: ./gradlew clean build -PbuildNumber=0 --no-daemon